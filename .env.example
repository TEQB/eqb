# ─── Public (safe to expose to the browser) ────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-site-url.example.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
# School email domain that non-open-level registrations must use (e.g. @tech-u.edu.ng)
NEXT_PUBLIC_UNIVERSITY_EMAIL_DOMAIN=@your-university.edu.ng

# ─── Secrets — NEVER commit real values ────────────────────────────────────
# Supabase service role key — bypasses RLS. Treat like a root password.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Obfuscated path for the admin area (e.g. /admin/<this value>). Keep secret.
ADMIN_SECRET_PATH=your-admin-secret-path
# Email of the initial super_admin account.
ADMIN_INITIAL_EMAIL=admin@your-domain.example.com

# ─── AI moderation providers ───────────────────────────────────────────────
# Provider chain order; at least ONE provider key must be set for uploads to work.
MODERATION_PROVIDER_ORDER=groq,nvidia,gemini

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Groq (images only — does not support PDFs)
GROQ_API_KEY=your-groq-api-key
GROQ_MODERATION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# NVIDIA (images only — does not support PDFs)
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_MODERATION_MODEL=meta/llama-4-scout-17b-16e-instruct

# ─── Email providers (fallback chain) ──────────────────────────────────────
BREVO_API_KEY=your-brevo-api-key
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=EQB <noreply@your-domain.example.com>
MAILJET_API_KEY=your-mailjet-api-key
MAILJET_SECRET_KEY=your-mailjet-secret-key
